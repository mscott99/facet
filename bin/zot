#!/usr/bin/env python3
"""zot pdf <citekey> [-o DIR] — fetch a paper's PDF by Better BibTeX citekey.
Order: Zotero file storage (API) -> WebDAV (Koofr, <attachmentKey>.zip) -> arXiv.
Credentials come from ~/.env (ZOTERO_API_KEY, ZOTERO_USER_ID, ZOTERO_KOOFR_USER,
ZOTERO_KOOFR_P); never printed. Downloaded files are only written, never executed."""
import os, sys, re, io, json, zipfile, urllib.request, urllib.parse, urllib.error, base64

def env():
    d = {}
    for l in open(os.path.expanduser("~/.env")):
        m = re.match(r"\s*(?:export\s+)?([A-Z_]+)=(.*)$", l.rstrip("\n"))
        if m: d[m[1]] = m[2].strip().strip("'\"")
    return d

E = env()
API = "https://api.zotero.org/users/%s" % E.get("ZOTERO_USER_ID", "")

def get(url, headers=None, auth=None):
    h = dict(headers or {})
    if auth: h["Authorization"] = "Basic " + base64.b64encode(("%s:%s" % auth).encode()).decode()
    with urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=60) as r:
        return r.read()

def zapi(path):
    return json.loads(get(API + path, {"Zotero-API-Key": E["ZOTERO_API_KEY"]}))

def find_item(ck):
    # vault note may give the item key; else search by citekey
    for root, _, files in os.walk(os.path.expanduser("~/Obsidian/myVault/References")):
        if "@%s.md" % ck in files:
            t = open(os.path.join(root, "@%s.md" % ck)).read()
            m = re.search(r"zotero://(?:select|open-pdf)/library/items/([A-Z0-9]{8})", t)
            if m:
                it = zapi("/items/" + m[1])["data"]
                return it.get("parentItem") or it["key"]
            break
    q = re.sub(r"(\d{4})$", "", ck)
    for it in zapi("/items?limit=50&q=" + urllib.parse.quote(re.split(r"[A-Z]", ck)[0])):
        if it["data"].get("citationKey") == ck: return it["key"]
    sys.exit("citekey not found: " + ck)

def main():
    a = sys.argv[1:]
    H = ("-h", "--help", "help")
    if not a or a[0] in H or any(x in ("-h", "--help") for x in a):
        print(__doc__); return
    if a[0] != "pdf" or len(a) < 2: sys.exit("usage: zot pdf <citekey> [-o DIR]")
    ck, out = a[1], "."
    if "-o" in a: out = a[a.index("-o") + 1]
    os.makedirs(out, exist_ok=True)
    pk = find_item(ck)
    parent = zapi("/items/" + pk)["data"]
    kids = [c["data"] for c in zapi("/items/%s/children" % pk) if c["data"].get("contentType") == "application/pdf"]
    for c in kids:
        name = os.path.basename(c.get("filename") or ck + ".pdf")
        dest = os.path.join(out, name)
        try:  # 1 Zotero storage
            data = get("%s/items/%s/file" % (API, c["key"]), {"Zotero-API-Key": E["ZOTERO_API_KEY"]})
            open(dest, "wb").write(data); print("zotero-storage", dest); return
        except Exception: pass
        if E.get("ZOTERO_KOOFR_USER"):  # 2 WebDAV
            try:
                z = get("https://app.koofr.net/dav/Koofr/zotero/%s.zip" % c["key"], auth=(E["ZOTERO_KOOFR_USER"], E["ZOTERO_KOOFR_P"]))
                zf = zipfile.ZipFile(io.BytesIO(z))
                pdfs = [n for n in zf.namelist() if n.lower().endswith(".pdf")]
                if pdfs:
                    open(dest, "wb").write(zf.read(pdfs[0])); print("webdav", dest); return
            except Exception: pass
    # 3 arXiv
    blob = parent.get("extra", "") + " " + parent.get("url", "") + " " + parent.get("DOI", "")
    m = re.search(r"(?:arXiv[:.]|arxiv\.org/abs/|10\.48550/arXiv\.)\s*([0-9]{4}\.[0-9]{4,5}|[a-z\-]+/[0-9]{7})", blob, re.I)
    if m:
        dest = os.path.join(out, "arXiv-%s.pdf" % m[1].replace("/", "_"))
        open(dest, "wb").write(get("https://arxiv.org/pdf/%s" % m[1])); print("arxiv", dest); return
    sys.exit("no PDF found for " + ck)

try: main()
except urllib.error.HTTPError as e: sys.exit("HTTP %s" % e.code)
